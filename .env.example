# Copy to .env and fill in your own values for Docker Compose.
# Without a key, posting and voting work but AI grouping is disabled.
# Docker reads keys from this file only; exported shell keys are not inherited.
# Never put the hosted demo's dedicated key here.
TYPESAFE_API_KEY=
ORGANIZER_TOKEN=
MERGEPOLL_PORT=5173
# Host address to publish on. Keep 127.0.0.1 for this computer only; use
# 0.0.0.0 so devices on the same network can join at http://<your-LAN-IP>:5173.
MERGEPOLL_HOST=127.0.0.1
